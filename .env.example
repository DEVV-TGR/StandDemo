# ------------------------------------------------------------------
# Variáveis de ambiente — copiar para .env.local e preencher.
# Na Vercel, definir as mesmas em Project → Settings → Environment Variables.
# ------------------------------------------------------------------

# Base de dados Neon (Postgres) — Connection string do projeto.
# Neon → projeto → Connection Details → "Connection string" (com ?sslmode=require).
DATABASE_URL="postgresql://utilizador:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Autenticação (Auth.js) — segredo para assinar as sessões.
# Gerar com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET="cole-aqui-um-segredo-aleatorio"

# Armazenamento de fotos — Cloudflare R2 (S3-compatível).
# Cloudflare → R2 → Manage R2 API Tokens (Access Key/Secret) e o Account ID.
R2_ACCOUNT_ID="o-seu-account-id-cloudflare"
R2_ACCESS_KEY_ID="a-sua-access-key"
R2_SECRET_ACCESS_KEY="a-sua-secret-key"
R2_BUCKET="nome-do-bucket"
# URL público do bucket: domínio próprio (ex.: https://cdn.exemplo.pt)
# ou o domínio r2.dev do bucket (ex.: https://pub-xxxx.r2.dev).
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ------------------------------------------------------------------
# Apenas para o comando de seed (npm run db:seed) — cria o 1º admin.
# ------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@imperioautoconcept.pt"
SEED_ADMIN_PASSWORD="troque-esta-password"
