# Modelo das variáveis de ambiente. Copiar para `.env.local` e preencher.
#
# O `.env.local` está no `.gitignore`; este ficheiro está versionado de
# propósito, e por isso NUNCA leva valores reais — só a forma deles.
#
# Nenhuma variável leva o prefixo `NEXT_PUBLIC_`. Esse prefixo faz o Next
# embutir o valor no JavaScript que vai para o browser, onde fica visível a
# quem abrir o código-fonte da página. Se um valor precisar de estar no
# cliente, não é segredo — e a pergunta a fazer é outra.
#
# **O site funciona sem nada disto.** Sem `DATABASE_URL` serve o inventário
# estático de `src/data/viaturas.ts`; é assim que o CI corre o build, e é a
# rede que impede a repetição do que aconteceu no PR #12.


# --- Base de dados (Neon) --------------------------------------------------
# Dashboard → Connect. Usar a string do branch `dev` em desenvolvimento e a do
# `main` em produção: contra o `main` só correm migrações versionadas, porque é
# lá que estão as viaturas reais do cliente.
#
# Preferir a variante com `-pooler` no host.
DATABASE_URL="postgresql://utilizador:password@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"


# --- Fotografias (Cloudflare R2) -------------------------------------------
# O token deve ser `Object Read & Write` **restrito ao bucket**, não com
# permissões de conta. R2 → Manage API Tokens.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="imperio-viaturas"

# De onde o browser carrega as imagens — o único destes valores que é público
# por natureza. Não confundir com o endpoint S3
# (`https://<ACCOUNT_ID>.r2.cloudflarestorage.com`), que é por onde o servidor
# escreve, exige assinatura em cada pedido, e o código constrói sozinho a
# partir do `R2_ACCOUNT_ID`.
#
# O `pub-….r2.dev` é limitado por taxa e a Cloudflare diz que só serve para
# desenvolvimento. Produção usa um domínio próprio — ver `docs/admin/07`.
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"


# --- Email (Resend) --------------------------------------------------------
# Serve dois sítios: o código de acesso ao painel e os pedidos que chegam pelos
# formulários de /compramos e /importamos. Sem estas variáveis, em
# desenvolvimento o email sai no terminal; em produção o formulário diz que não
# consegue enviar e encaminha para o WhatsApp.
#
# O remetente tem de usar um domínio que esteja como *Verified* no Resend, à
# letra. A raiz e o subdomínio são domínios diferentes: com `send.exemplo.pt`
# verificado, um remetente `@exemplo.pt` é recusado com 403.
#
# O domínio verificado governa o remetente, não o destinatário — dá para enviar
# para qualquer endereço.
RESEND_API_KEY=""
RESEND_REMETENTE="Painel Império <noreply@send.exemplo.pt>"

# Para onde vão os pedidos dos formulários. Vazio ou ausente = o email do stand
# em `src/data/stand.ts`, que é o que vale em produção. Existe para testar sem
# disparar emails para a caixa do cliente.
PEDIDOS_DESTINO=""


# --- Quem entra no painel --------------------------------------------------
# Lista separada por vírgulas. Não há tabela de utilizadores nem palavras-passe:
# quem está nesta lista pede um código e recebe-o, quem não está não recebe
# nada — e o ecrã responde exactamente o mesmo aos dois, para o formulário não
# se tornar uma ferramenta de descobrir quem tem acesso.
#
# Endereços individuais, nunca um `geral@`: um email visto por cinco pessoas
# não autentica ninguém. E o email tem de ter, ele próprio, verificação em dois
# passos — é a única coisa que separa o painel de um atacante.
#
# Mudar esta variável exige um redeploy para valer.
PAINEL_EMAILS="pessoa@exemplo.pt"
